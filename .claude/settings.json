{
	"enabledPlugins": {
		"frontend-design@claude-plugins-official": true
	},
	"hooks": {
		"Notification": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify.sh\""
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"if": "Edit(*.ts)|Write(*.ts)",
						"command": "jq -r '.tool_input.file_path // empty' | xargs -I {} npx prettier --write --ignore-unknown {}"
					},
					{
						"type": "command",
						"if": "Edit(*.ts)|Write(*.ts)",
						"command": "npm run lint -- --fix"
					}
				]
			}
		]
	}
}
